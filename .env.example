# Datenbank — MongoDB Atlas, kostenloser M0-Cluster
# cloud.mongodb.com -> Cluster anlegen -> Connect -> Drivers -> Python -> Connection String
MONGO_URL=mongodb+srv://BENUTZER:PASSWORT@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=bvm_newsletter

# Wer darf die API aufrufen? Deine Website-Adressen, mit Komma getrennt.
CORS_ORIGINS=https://bvm-ev.de,https://www.bvm-ev.de,https://bvmevgiessen.github.io

# KI-Editorial ("Editorial der Redaktion")
EMERGENT_LLM_KEY=

# Mailversand — resend.com -> API Keys
RESEND_API_KEY=
SENDER_EMAIL=newsletter@bvm-ev.de
SENDER_NAME=BVM e.V. Gießen

# Die öffentliche Adresse DIESES Backends. Landet in den Bestätigungs-
# und Abmeldelinks der E-Mails, muss also von außen erreichbar sein.
PUBLIC_BASE_URL=https://bvm-newsletter-api.onrender.com

# Datenquelle für Events und Blogs (dein GitHub-Repo)
NEWSLETTER_SOURCE_BASE=https://raw.githubusercontent.com/bvmevgiessen/bvm-ev-web/main
